CREATE TABLE playList (
  id TEXT NOT NULL PRIMARY KEY,
  updatedAt INTEGER DEFAULT (strftime('%s', 'now')) NOT NULL,
  createdAt INTEGER DEFAULT (strftime('%s', 'now')) NOT NULL
);

 selectAll:
 SELECT *
 FROM playList;

 insert:
 INSERT INTO playList(id)
 VALUES (?);

 deleteById:
 DELETE FROM playList
 WHERE id = ?;